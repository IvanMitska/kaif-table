generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String
  role         Role          @default(ACCOUNTANT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  type         CategoryType  @default(EXPENSE)
  color        String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model PaymentMethod {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Transaction {
  id              Int           @id @default(autoincrement())
  date            DateTime
  amount          Float
  service         String
  supplier        String?
  comment         String?
  hasReceipt      Boolean       @default(false)
  enteredInIiko   Boolean       @default(false)

  categoryId      Int
  category        Category      @relation(fields: [categoryId], references: [id])

  paymentMethodId Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  userId          Int
  user            User          @relation(fields: [userId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum Role {
  ADMIN
  ACCOUNTANT
  MANAGER
}

enum CategoryType {
  INCOME
  EXPENSE
}

// iiko Integration Settings
model IikoSettings {
  id            Int      @id @default(autoincrement())
  serverUrl     String   // e.g., https://your-iiko-server:443
  login         String
  passwordHash  String   // SHA1 hash of password
  isActive      Boolean  @default(true)
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// iiko Sales Data (imported from iiko)
model IikoSale {
  id              Int      @id @default(autoincrement())
  dishId          String
  dishName        String
  dishCode        String?
  dishCategory    String
  dishCategoryId  String?
  dishGroup       String?
  dishGroupId     String?
  quantity        Float
  amount          Float
  discountSum     Float    @default(0)
  orderNum        String
  openTime        DateTime
  departmentId    String?
  departmentName  String?
  importedAt      DateTime @default(now())

  // Extended fields for deep analytics (verified working with iiko Syrve)
  waiterId        String?
  waiterName      String?
  paymentType     String?
  orderType       String?
  tableNum        String?
  guestCount      Int?
  closeTime       DateTime?
  discountType    String?
  sessionNum      String?
  productCost     Float?              // Себестоимость (not available in OLAP)
  cookingPlace    String?             // Kitchen place (Bar, Kitchen Hot, Pool)
  nonCashPaymentType String?          // Non-cash payment details

  @@index([openTime])
  @@index([dishCategory])
  @@index([orderNum])
  @@index([waiterId])
  @@index([paymentType])
  @@index([tableNum])
}
